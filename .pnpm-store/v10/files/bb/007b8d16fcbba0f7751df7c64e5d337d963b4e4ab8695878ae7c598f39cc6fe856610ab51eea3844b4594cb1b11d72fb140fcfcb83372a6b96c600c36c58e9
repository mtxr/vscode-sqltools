{
    "name": "xshell",
    "version": "1.2.8",
    "type": "module",
    "main": "./index.js",
    "bin": {
        "xshell": "xshell.js",
        "i18n-scan": "i18n/i18n-scan.js"
    },
    "description": "xshell is a shell designed to provide a brand new human-computer interaction experience.",
    "keywords": [
        "shell",
        "node",
        "repl",
        "i18n",
        "interactive programming"
    ],
    "scripts": {
        "start": "node --title=xshell --inspect=0.0.0.0:8420 ./xshell.js",
        "typecheck": "tsc --noEmit",
        "build": "tsc",
        "package": "vsce package",
        "publish:npm": "npm publish --access=public",
        "publish:extension": "vsce publish"
    },
    "author": "ShenHongFei <shen.hongfei@outlook.com> (https://github.com/ShenHongFei)",
    "publisher": "ShenHongFei",
    "homepage": "https://www.npmjs.com/package/xshell",
    "icon": "xshell.png",
    "extensionKind": [
        "workspace"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "contributes": {
        "commands": [
            {
                "command": "xshell_repl",
                "title": "xshell_repl"
            }
        ],
        "keybindings": [
            {
                "command": "xshell_repl",
                "key": "ctrl+enter",
                "when": "editorTextFocus && (editorLangId == 'typescript' || editorLangId == 'javascript' || editorLangId == 'typescriptreact' || editorLangId == 'javascriptreact')"
            }
        ]
    },
    "dependencies": {
        "@babel/core": "^7.26.0",
        "@babel/parser": "^7.26.5",
        "@babel/traverse": "^7.26.5",
        "@koa/cors": "^5.0.0",
        "@stylistic/eslint-plugin": "^2.13.0",
        "@svgr/webpack": "^8.1.0",
        "@types/sass-loader": "^8.0.9",
        "@types/ws": "^8.5.13",
        "@typescript-eslint/eslint-plugin": "^8.20.0",
        "@typescript-eslint/parser": "^8.20.0",
        "@typescript-eslint/utils": "^8.20.0",
        "archiver": "^7.0.1",
        "chalk": "^5.4.1",
        "cli-table3": "^0.6.5",
        "cli-truncate": "^4.0.0",
        "commander": "^13.0.0",
        "css-loader": "^7.1.2",
        "emoji-regex": "^10.4.0",
        "eslint": "^9.18.0",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-react": "^7.37.4",
        "gulp-sort": "^2.0.0",
        "https-proxy-agent": "^7.0.6",
        "i18next": "^24.2.1",
        "i18next-scanner": "^4.6.0",
        "koa": "^2.15.3",
        "koa-compress": "^5.1.1",
        "license-webpack-plugin": "^4.0.2",
        "lodash": "^4.17.21",
        "map-stream": "^0.0.7",
        "mime-types": "^2.1.35",
        "ora": "^8.1.1",
        "react": "^19.0.0",
        "react-i18next": "^15.4.0",
        "react-object-model": "^1.2.21",
        "resolve-path": "^1.4.0",
        "sass": "^1.83.4",
        "sass-loader": "^16.0.4",
        "source-map-loader": "^5.0.0",
        "strip-ansi": "^7.1.0",
        "style-loader": "^4.0.0",
        "through2": "^4.0.2",
        "tough-cookie": "^5.1.0",
        "ts-loader": "^9.5.2",
        "tslib": "^2.8.1",
        "typescript": "^5.7.3",
        "ua-parser-js": "^2.0.0",
        "undici": "^7.2.2",
        "vinyl": "^3.0.0",
        "vinyl-fs": "^4.0.0",
        "webpack": "^5.97.1",
        "webpack-bundle-analyzer": "^4.10.2",
        "ws": "^8.18.0"
    },
    "devDependencies": {
        "@babel/types": "^7.26.5",
        "@types/archiver": "^6.0.3",
        "@types/babel__traverse": "^7.20.6",
        "@types/eslint": "^9.6.1",
        "@types/estree": "^1.0.6",
        "@types/gulp-sort": "^2.0.4",
        "@types/koa": "^2.15.0",
        "@types/koa-compress": "^4.0.6",
        "@types/lodash": "^4.17.14",
        "@types/mime-types": "^2.1.4",
        "@types/node": "^22.10.7",
        "@types/react": "^19.0.7",
        "@types/through2": "^2.0.41",
        "@types/tough-cookie": "^4.0.5",
        "@types/ua-parser-js": "^0.7.39",
        "@types/vinyl-fs": "^3.0.5",
        "@types/vscode": "^1.96.0",
        "@types/webpack-bundle-analyzer": "^4.7.0"
    },
    "pnpm": {
        "patchedDependencies": {
            "koa@2.15.3": "patches/koa@2.15.3.patch"
        }
    }
}
