{"version":3,"file":"hooks.js","sourceRoot":"","sources":["hooks.ts"],"names":[],"mappings":"AAAA,OAAO,EAAE,SAAS,EAAE,MAAM,EAAE,QAAQ,EAAsD,MAAM,OAAO,CAAA;AAGvG,MAAM,UAAU,YAAY;IACxB,MAAM,SAAS,GAAG,QAAQ,CAAC,EAAG,CAAC,CAAC,CAAC,CAAC,CAAA;IAElC,OAAO,SAAS,QAAQ;QACpB,SAAS,CAAC,EAAG,CAAC,CAAA;IAClB,CAAC,CAAA;AACL,CAAC;AAGD,MAAM,UAAU,SAAS;IACrB,MAAM,CAAC,OAAO,EAAE,WAAW,CAAC,GAAG,QAAQ,CAAC,KAAK,CAAC,CAAA;IAE9C,OAAO;QACH,OAAO;QAEP,IAAI;YACA,WAAW,CAAC,IAAI,CAAC,CAAA;QACrB,CAAC;QAED,KAAK;YACD,WAAW,CAAC,KAAK,CAAC,CAAA;QACtB,CAAC;KACJ,CAAA;AACL,CAAC;AAUD,8EAA8E;AAC9E,MAAM,UAAU,aAAa,CAAW,aAAuC;IAK3E,IAAI,CAAC,KAAK,EAAE,UAAU,CAAC,GAAG,QAAQ,CAAC,aAAa,CAAC,CAAA;IACjD,IAAI,GAAG,GAAG,MAAM,CAAC,KAAK,CAAC,CAAA;IACvB,OAAO,CAAC,KAAK,EAAE,GAAG,EAAE,CAAC,KAAa,EAAE,EAAE,GAAG,UAAU,CAAC,GAAG,CAAC,OAAO,GAAG,KAAK,CAAC,CAAA,CAAC,CAAC,CAAC,CAAA;AAC/E,CAAC;AAGD,2CAA2C;AAC3C,MAAM,UAAU,UAAU,CAA+C,cAAsB;IAG3F,IAAI,CAAC,MAAM,EAAE,UAAU,CAAC,GAAG,QAAQ,CAAC,cAAc,CAAC,CAAA;IACnD,IAAI,GAAG,GAAG,MAAM,CAAW,SAAS,CAAC,CAAA;IAErC,SAAS,CAAC,GAAG,EAAE;QACX,IAAI,GAAG,CAAC,OAAO;YACX,UAAU,CAAC,GAAG,CAAC,OAAO,CAAC,YAAY,CAAC,CAAA;IAC5C,CAAC,EAAE,CAAC,GAAG,CAAC,OAAO,CAAC,CAAC,CAAA;IAEjB,OAAO,CAAC,MAAM,EAAE,GAAG,CAAC,CAAA;AACxB,CAAC","sourcesContent":["import { useEffect, useRef, useState, type Dispatch, type RefObject, type SetStateAction } from 'react'\n\n\nexport function use_rerender () {\n    const set_state = useState({ })[1]\n    \n    return function rerender () {\n        set_state({ })\n    }\n}\n\n\nexport function use_modal (): ModalController {\n    const [visible, set_visible] = useState(false)\n    \n    return {\n        visible,\n        \n        open () {\n            set_visible(true)\n        },\n        \n        close () {\n            set_visible(false)\n        }\n    }\n}\n\n\nexport interface ModalController {\n    visible: boolean\n    open(): void\n    close(): void\n}\n\n\n/** 类似 useState, 同时将 state 绑定到 ref 从而方便的获取其最新的值, 返回 [state, ref, set_state] */\nexport function use_ref_state <TState> (initial_state?: TState | (() => TState)): [\n    TState,\n    RefObject<TState>,\n    Dispatch<SetStateAction<TState>>\n] {\n    let [state, _set_state] = useState(initial_state)\n    let ref = useRef(state)\n    return [state, ref, (value: TState) => { _set_state(ref.current = value) }]\n}\n\n\n/** 根据 html element 渲染的高度更新 height state */\nexport function use_height <TElement extends HTMLElement = HTMLElement> (initial_height: number): [\n    number, RefObject<TElement>\n] {\n    let [height, set_height] = useState(initial_height)\n    let ref = useRef<TElement>(undefined)\n    \n    useEffect(() => {\n        if (ref.current)\n            set_height(ref.current.clientHeight)\n    }, [ref.current])\n    \n    return [height, ref]\n}\n"]}